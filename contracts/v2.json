  },
  "components": {
    "schemas": {
      "CreateShipmentRequest": {
        "required": [
          "trackingNumber",
          "recipientName",
          "recipientPhone",
          "address",
          "city"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "pattern": "APX-[0-9]{8}",
            "type": "string",
            "description": "Tracking identifier in APX-12345678 format."
          },
          "weightKg": {
            "maximum": 70,
            "minimum": 0.1,
            "type": "number",
            "description": "Shipment weight in kilograms, inclusive range 0.1 to 70.",
            "format": "double"
          },
          "recipientName": {
            "maxLength": 120,
            "type": "string",
            "description": "Fictional recipient full name, required."
          },
          "recipientPhone": {
            "maxLength": 25,
            "pattern": "\\+?[1-9][0-9]{6,14}",
            "type": "string",
            "description": "Recipient phone: optional plus followed by 7 to 15 digits; first digit is nonzero."
          },
          "address": {
            "maxLength": 300,
            "type": "string",
            "description": "Recipient street address, required."
          },
          "city": {
            "maxLength": 120,
            "type": "string",
            "description": "Recipient city, required; list filtering uses exact database comparison."
          }
        },
        "description": "Contract for CreateShipmentRequest."
      },
      "DeliveryStatus": {
        "enum": [
          "Created",
          "PickedUp",
          "InTransit",
          "OutForDelivery",
          "Delivered",
          "Failed"
        ]
      },
      "LatestScanResponse": {
        "required": [
          "scanType",
          "location",
          "scannedAtUtc"
        ],
        "type": "object",
        "properties": {
          "scanType": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "scannedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Contract for LatestScanResponse."
      },
      "PageResponseOfShipmentV2": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipmentV2"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Contract for PageResponse."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "RecipientResponse": {
        "required": [
          "name",
          "phone",
          "address",
          "city"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        },
        "description": "Contract for RecipientResponse."
      },
      "ScanRejectionResponse": {
        "required": [
          "id",
          "reason"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "description": "Contract for ScanRejectionResponse."
      },
      "ScanResponse": {
        "required": [
          "id",
          "trackingNumber",
          "scanType",
          "courierId",
          "location",
          "scannedAtUtc",
          "notes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "trackingNumber": {
            "type": "string"
          },
          "scanType": {
            "type": "string"
          },
          "courierId": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "scannedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        },
        "description": "A persisted courier scan, with its stable Part A identifier and UTC timestamp."
      },
      "ScanUploadRequest": {
        "required": [
          "id",
          "trackingNumber",
          "scanType",
          "courierId",
          "location"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "scan::[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}",
            "type": "string",
            "description": "Stable Part A scan identifier in scan::{Guid} format."
          },
          "trackingNumber": {
            "pattern": "APX-[0-9]{8}",
            "type": "string",
            "description": "Tracking identifier in APX-12345678 format."
          },
          "scanType": {
            "pattern": "^(Pickup|InTransit|Delivered|Failed)$",
            "type": "string",
            "description": "Courier event: Pickup, InTransit, Delivered or Failed."
          },
          "courierId": {
            "maxLength": 100,
            "type": "string",
            "description": "Fictional courier identifier; Part D adds authenticated ownership checks."
          },
          "location": {
            "maxLength": 200,
            "type": "string",
            "description": "Fictional location where the event was recorded."
          },
          "scannedAtUtc": {
            "type": "string",
            "description": "Event timestamp; required and cannot be in the future.",
            "format": "date-time"
          },
          "notes": {
            "maxLength": 2000,
            "type": "string",
            "description": "Optional scan notes, maximum 2000 characters."
          }
        },
        "description": "Contract for ScanUploadRequest."
      },
      "ScanUploadResponse": {
        "required": [
          "accepted",
          "duplicatesSkipped",
          "rejected",
          "acceptedScanIds",
          "duplicateScanIds",
          "rejections"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer",
            "format": "int32"
          },
          "duplicatesSkipped": {
            "type": "integer",
            "format": "int32"
          },
          "rejected": {
            "type": "integer",
            "format": "int32"
          },
          "acceptedScanIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duplicateScanIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rejections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanRejectionResponse"
            }
          }
        },
        "description": "Contract for ScanUploadResponse."
      },
      "ShipmentV2": {
        "required": [
          "trackingNumber",
          "weightKg",
          "recipient",
          "status",
          "latestScan"
        ],
        "type": "object",
