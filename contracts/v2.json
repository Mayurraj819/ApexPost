      "get": {
        "tags": [
          "Scans"
        ],
        "summary": "Read a shipment's scan history in UTC order.",
        "operationId": "ListShipmentScansV2",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "required": true,
            "schema": {
              "maxLength": 12,
              "minLength": 12,
