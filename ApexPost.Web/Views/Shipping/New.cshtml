@model ApexPost.Web.Models.ShipmentRequest
@using ApexPost.Application.Contracts
@using ApexPost.Domain.Enums
@{ViewData["Title"]="Add shipping";var zones=ViewBag.Zones as IReadOnlyList<ZoneRow>??Array.Empty<ZoneRow>();}
<h1>Add shipping service</h1>
<form asp-action="Add" method="post" class="row g-3">
@Html.AntiForgeryToken()<input asp-for="TransactionId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div>
<div class="col-md-6"><label asp-for="ZoneId" class="form-label">Zone</label><select asp-for="ZoneId" class="form-select">@foreach(var zone in zones){<option value="@zone.Id">@zone.Name</option>}</select></div>
<div class="col-md-6"><label asp-for="ServiceLevel" class="form-label"></label><select asp-for="ServiceLevel" asp-items="Html.GetEnumSelectList<ShippingServiceLevel>()" class="form-select"></select></div>
<div class="col-md-6"><label asp-for="WeightGrams" class="form-label"></label><input asp-for="WeightGrams" class="form-control"/></div>
<div class="col-md-6"><label asp-for="Recipient" class="form-label"></label><input asp-for="Recipient" class="form-control"/></div>
<div class="col-12"><label asp-for="Street" class="form-label"></label><input asp-for="Street" class="form-control"/></div>
<div class="col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control"/></div>
<div class="col-md-6"><label asp-for="PostalCode" class="form-label"></label><input asp-for="PostalCode" class="form-control"/></div>
<button class="btn btn-primary">Calculate and add charge</button></form>
