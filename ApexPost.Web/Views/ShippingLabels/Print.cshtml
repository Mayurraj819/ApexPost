@model ApexPost.Web.Models.ShippingLabelViewModel
@{
    ViewData["Title"] = "Shipping Receipt";
}

<section class="shipping-receipt">
    <h1>ApexPost – Shipping Receipt</h1>
    <p><strong>Not a carrier tracking label.</strong> Tracking number, sender and recipient addresses are not captured in the current transaction schema.</p>
    <dl>
        <dt>Transaction</dt><dd>@Model.TransactionId</dd>
        <dt>Branch</dt><dd>@Model.BranchId</dd>
        <dt>Date</dt><dd>@Model.TransactionDate.ToString("yyyy-MM-dd HH:mm")</dd>
        <dt>Shipping line</dt><dd>@Model.LineNumber</dd>
        <dt>Service code</dt><dd>@Model.ServiceCode</dd>
        <dt>Service level</dt><dd>@Model.ServiceLevel</dd>
        <dt>Amount</dt><dd>@Model.Amount.ToString("N2") @Model.Currency</dd>
    </dl>
</section>
<div class="no-print text-center"><button class="btn btn-primary" type="button" data-print="true">Print receipt</button></div>
