@model IReadOnlyList<ApexPost.Domain.Entities.Transaction>
@{ ViewData["Title"] = "Transactions"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Branch transactions</h1><a asp-action="New" class="btn btn-primary">+ New transaction</a></div>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-hover">
<thead><tr><th>Time</th><th>Transaction</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody>
@foreach(var t in Model){<tr><td>@t.OccurredAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><code>@t.Id.ToString()[..8]</code></td><td><span class="badge text-bg-secondary">@t.Status</span></td><td>@t.Total.Amount.ToString("N2") @t.Total.Currency</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@t.Id">Open</a></td></tr>}
</tbody></table></div>
@if(Model.Count==0){<p class="text-muted">No transactions found.</p>}
</div></div>
