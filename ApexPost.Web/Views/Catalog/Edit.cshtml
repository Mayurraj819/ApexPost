@model ApexPost.Web.Models.ProductEditorModel
@{ ViewData["Title"] = Model.Id == Guid.Empty ? "Add product" : "Edit product"; }
<h1>@ViewData["Title"]</h1>
<div class="card mt-3"><div class="card-body">
<form asp-action="Save" method="post" class="row g-3">
@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
<div asp-validation-summary="All" class="text-danger"></div>
<div class="col-md-4"><label asp-for="Sku" class="form-label"></label><input asp-for="Sku" class="form-control" /><span asp-validation-for="Sku" class="text-danger"></span></div>
<div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Price" class="form-label">Price (PHP)</label><input asp-for="Price" type="number" step=".01" min=".01" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Category" class="form-label"></label><select asp-for="Category" asp-items="Html.GetEnumSelectList<ApexPost.Domain.Enums.ProductCategory>()" class="form-select"></select></div>
<div class="col-12 action-bar"><button class="btn btn-primary" type="submit">Save product</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div>
