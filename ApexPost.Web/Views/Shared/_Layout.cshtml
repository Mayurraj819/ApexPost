<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · ApexPost</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" asp-append-version="true" href="~/css/site.css" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
 <div class="container-fluid">
  <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Dashboard">📦 ApexPost</a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
  <div class="collapse navbar-collapse" id="mainNav">
   @if (User.Identity?.IsAuthenticated == true)
   {
    <div class="navbar-nav me-auto">
     <a class="nav-link" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
     <a class="nav-link" asp-controller="Catalog" asp-action="Index">Catalogue</a>
     <a class="nav-link" asp-controller="Stock" asp-action="Index">Stock</a>
     <a class="nav-link" asp-controller="Transactions" asp-action="Index">Transactions</a>
     <a class="nav-link" asp-controller="Transactions" asp-action="New">New sale</a>
     <a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a>
     <a class="nav-link" asp-controller="OperationalAlerts" asp-action="Index">Alerts</a>
    </div>
    <span class="text-light small me-3">@User.Identity.Name</span>
    <form asp-controller="Account" asp-action="Logout" method="post">
     @Html.AntiForgeryToken()
     <button class="btn btn-outline-light btn-sm" type="submit">Logout</button>
    </form>
   }
  </div>
 </div>
</nav>
<main class="container py-4">
 @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
 @if (TempData["Error"] is string error) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
 @RenderBody()
</main>
<footer class="border-top bg-white py-3 mt-5"><div class="container text-muted small">ApexPost · Branch operations</div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
