<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApexPost</title>
</head>
<body>
    <header>
        <nav>
            <a asp-controller="Home" asp-action="Dashboard">ApexPost</a>
            <a asp-controller="Catalog" asp-action="Index">Catalogue</a>
            <a asp-controller="Reports" asp-action="Index">Reports</a>
            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit">Logout</button>
            </form>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
</body>
</html>
